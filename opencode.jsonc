{
  "$schema": "https://opencode.ai",
  "instructions": [
    "AGENTS.md"
  ],
  "formatter": {
    "prettier": {
      "disabled": false
    }
  },
  "permissions": {
    "bash": {
      "npm run typecheck*": "allow",
      "npm run lint*": "allow",
      "npm test*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git push*": "deny",
      "rm -rf*": "deny"
    }
  }
}
